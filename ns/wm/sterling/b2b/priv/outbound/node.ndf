      <record name="assembly" javaclass="com.wm.util.Values">
        <array name="execute" type="value" depth="1">
          <record javaclass="com.wm.util.Values">
            <record name="activity-log" javaclass="com.wm.util.Values">
              <value name="title">activity-log</value>
              <value name="content">header</value>
              <value name="error-content">header</value>
              <value name="version">1.5.0</value>
            </record>
          </record>
          <record javaclass="com.wm.util.Values">
            <record name="gatewayscript" javaclass="com.wm.util.Values">
              <value name="version">2.0.0</value>
              <value name="title">gatewayscript</value>
              <value name="source">var apim = require('apim'); apim.output('application/json');
var clientId = apim.getvariable('request.headers.X-IBM-Client-Id'); var clientSecret = apim.getvariable('request.headers.X-IBM-Client-Secret'); var env = apim.getvariable('request.headers.X-IBM-Env');
apim.setvariable('message.headers.X-IBM-Client-Id', clientId, 'set'); apim.setvariable('message.headers.X-IBM-Client-Secret', clientSecret, 'set');
var catalog = apim.getvariable('api.catalog.path');
if (catalog === 'run' &amp;&amp; env === 'prod') {
    apim.setvariable('backendEnvHost', apim.getvariable('backend-url-production'), 'set');
} else if (catalog === 'run' &amp;&amp; env === 'cte') {
    apim.setvariable('backendEnvHost', apim.getvariable('backend-url-cte'), 'set');
} else if (['development', 'test', 'sandbox'].includes(catalog) &amp;&amp; env === 'qa') {
    apim.setvariable('backendEnvHost', apim.getvariable('backend-url-qa'), 'set');
} else {
    apim.error('BadCatalog or env header value', 400, 'Bad Request', 'Invalid catalog or header value');
}
apim.setvariable('operationPath','/wmi/api/v1/inbound/workflow/finished','set'); if(apim.getvariable('request.uri').toLowerCase().includes('/health')){
  apim.setvariable('operationPath','/wmi/api/v1/inbound/health','set');
}
</value>
            </record>
          </record>
          <record javaclass="com.wm.util.Values">
            <record name="proxy" javaclass="com.wm.util.Values">
              <number name="timeout" type="Integer">120</number>
              <value name="verb">keep</value>
              <value name="cache-response">protocol</value>
              <value name="cache-ttl">900</value>
              <value name="version">1.5.0</value>
              <value name="title">proxy</value>
              <Boolean name="compression">false</Boolean>
              <Boolean name="final-action">false</Boolean>
              <value name="tls-profile">akamai-tls-profile:1.0.0</value>
              <value name="target-url">https://$(backendEnvHost)$(operationPath)</value>
            </record>
          </record>
        </array>
      </record>
      <record name="activity-log" javaclass="com.wm.util.Values">
        <Boolean name="enabled">true</Boolean>
        <value name="success-content">activity</value>
        <value name="error-content">payload</value>
      </record>
      <record name="properties" javaclass="com.wm.util.Values">
        <record name="backend-url-qa" javaclass="com.wm.util.Values">
          <value name="value">api-qa.if.b2b.ibm.com</value>
        </record>
        <record name="backend-url-production" javaclass="com.wm.util.Values">
