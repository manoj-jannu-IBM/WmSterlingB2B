openapi: 3.0.0
info:
  title: WM APIs inbound
  contact:
    name: IBM Support
    url: https://www.ibm.com/support
    email: support@ibm.com
  version: 1.0.9
  x-ibm-name: wm-apis-inbound
servers:
- url: /
security:
- X-IBM-Client-Id: []
  X-IBM-Client-Secret: []
paths:
  /wmi/api/v1/inbound/health:
    get:
      tags:
      - inbound-controller-health-check
      summary: get health of inbound service
      description: get health of inbound service
      operationId: healthCheckOfInboundService
      responses:
        "200":
          description: success
  /wmi/api/v1/inbound/workflow/finished:
    post:
      tags:
      - inbound-controller
      summary: Drop off raw data to inbound service
      operationId: dropOffToOrchestrator
      requestBody:
        content:
          application/json:
            schema:
              required:
              - InboundRequestBody
              type: object
              properties:
                InboundRequestBody:
                  $ref: '#/components/schemas/InboundRequestBody'
        required: true
      responses:
        "200":
          description: OK
          content:
            application/json:
              schema:
                type: string
components:
  schemas:
    InboundRequestBody:
      required:
      - businessAlias
      - commandMessage
      - dataMessage
      - documentCode
      - processingFlags
      - status
      - trackingEventCode
      - workflowContextId
      - workflowExecutionId
      type: object
      properties:
        workflowExecutionId:
          minLength: 1
          type: string
        workflowContextId:
          minLength: 1
          type: string
        status:
          minLength: 1
          type: string
        company:
          type: string
        businessAlias:
          minLength: 1
          type: string
        processingFlags:
          $ref: '#/components/schemas/ProcessingFlags'
        commandMessage:
          pattern: "^[A-Za-z0-9+/=]+$"
          type: string
          description: Base64 encoded string
        documentCode:
          minLength: 1
          type: string
        trackingEventCode:
          minLength: 1
          type: string
        dataMessage:
          pattern: "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          type: string
          description: "Base64-encoded JSON string containing { content-type, encoding,\
            \ content }"
        destinationFilename:
          type: string
        documentType:
          type: string
        businessReference:
          type: string
        interchangeSenderID:
          type: string
        interchangeReceiverID:
          type: string
        transactionSetIDCode:
          type: string
        translationMap:
          type: string
        destinationPath:
          type: string
        destinationProtocolSender:
          type: string
        destinationProtocolReceiver:
          type: string
        destinationProtocolSubject:
          type: string
        senderNonEDIID:
          type: string
        receiverNonEDIID:
          type: string
        sourceUserDefined:
          $ref: '#/components/schemas/SourceUserDefined'
        extraInfo:
          $ref: '#/components/schemas/ExtraInfo'
        sourceReferenceNumber:
          type: string
        destinationExtensionKeys:
          $ref: '#/components/schemas/DestinationExtensionKeys'
        destinationExtensionValues:
          $ref: '#/components/schemas/DestinationExtensionValues'
    ProcessingFlags:
      type: object
      additionalProperties:
        type: string
      description: Processing flags for implementer fields (1-6)
      example:
        processingFlag1: value1
        processingFlag2: value2
        processingFlag3: value3
    SourceUserDefined:
      type: object
      additionalProperties:
        type: string
      description: Source user defined fields (1-3)
      example:
        sourceUserDefined1: value1
        sourceUserDefined2: value2
        sourceUserDefined3: value3
    ExtraInfo:
      type: object
      additionalProperties:
        type: string
      description: Extra information fields (1-3)
      example:
        extraInfo1: value1
        extraInfo2: value2
        extraInfo3: value3
    DestinationExtensionKeys:
      type: object
      additionalProperties:
        type: string
      description: Destination extension keys (1-25)
      example:
        destinationExtensionKey1: key1
        destinationExtensionKey2: key2
        destinationExtensionKey25: key25
    DestinationExtensionValues:
      type: object
      additionalProperties:
        type: string
      description: Destination extension values (1-25)
      example:
        destinationExtensionValue1: value1
        destinationExtensionValue2: value2
        destinationExtensionValue25: value25
  headers:
    X-IBM-Env:
      description: gives the env
      required: true
      style: simple
      explode: false
      schema:
        type: string
  securitySchemes:
    X-IBM-Client-Id:
      type: apiKey
      name: X-IBM-Client-Id
      in: header
      x-key-type: client_id
    X-IBM-Client-Secret:
      type: apiKey
      name: X-IBM-Client-Secret
      in: header
      x-key-type: client_secret
x-ibm-configuration:
  cors:
    enabled: true
  gateway: datapower-api-gateway
  type: rest
  phase: realized
  enforced: true
  testable: true
  validation:
    request:
      enabled: true
      nested: true
      reject-with:
        status: 400
        content-type: application/json
        body: |
          {
            "error": "Rejected from API Connect due to missing or invalid field: ${apim.validation.failure.property}"
          }
    response:
      enabled: false
  assembly:
    execute:
    - activity-log:
        title: activity-log
        content: header
        error-content: header
        version: 1.5.0
    - gatewayscript:
        version: 2.0.0
        title: gatewayscript
        source: |
          var apim = require('apim'); apim.output('application/json');
          var clientId = apim.getvariable('request.headers.X-IBM-Client-Id'); var clientSecret = apim.getvariable('request.headers.X-IBM-Client-Secret'); var env = apim.getvariable('request.headers.X-IBM-Env');
          apim.setvariable('message.headers.X-IBM-Client-Id', clientId, 'set'); apim.setvariable('message.headers.X-IBM-Client-Secret', clientSecret, 'set');
          var catalog = apim.getvariable('api.catalog.path');
          if (catalog === 'run' && env === 'prod') {
              apim.setvariable('backendEnvHost', apim.getvariable('backend-url-production'), 'set');
          } else if (catalog === 'run' && env === 'cte') {
              apim.setvariable('backendEnvHost', apim.getvariable('backend-url-cte'), 'set');
          } else if (['development', 'test', 'sandbox'].includes(catalog) && env === 'qa') {
              apim.setvariable('backendEnvHost', apim.getvariable('backend-url-qa'), 'set');
          } else {
              apim.error('BadCatalog or env header value', 400, 'Bad Request', 'Invalid catalog or header value');
          }
          apim.setvariable('operationPath','/wmi/api/v1/inbound/workflow/finished','set'); if(apim.getvariable('request.uri').toLowerCase().includes('/health')){
            apim.setvariable('operationPath','/wmi/api/v1/inbound/health','set');
          }
    - proxy:
        timeout: 120
        verb: keep
        cache-response: protocol
        cache-ttl: "900"
        version: 1.5.0
        title: proxy
        compression: false
        final-action: false
        tls-profile: akamai-tls-profile:1.0.0
        target-url: https://$(backendEnvHost)$(operationPath)
  activity-log:
    enabled: true
    success-content: activity
    error-content: payload
  properties:
    backend-url-qa:
      value: api-qa.if.b2b.ibm.com
    backend-url-production:
      value: api.if.b2b.ibm.com
    backend-url-cte:
      value: api-cte.if.b2b.ibm.com
